{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=filemanager-dev.db",
    "MigrateOnStartup": true,
    "ConnectRetrySeconds": 5
  },
  "FileManager": {
    "AllowNonRootDev": true,
    "BrowseRoots": [ "/tmp" ],
    "Impersonation": {
      "Enabled": false
    },
    "Auth": {
      "Provider": "shadow",
      "ExposeUserList": true,
      "AllowDevelopmentBypass": true
    },
    "Bootstrap": {
      "Enabled": false
    }
  }
}
