# Copy to .env and adjust. .env itself is git-ignored.
POSTGRES_DB=filemanager
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=filemanager

# Emergency administrator created inside the container (requirement 5).
# The value below is the documented default - change it for anything reachable.
FM_BOOTSTRAP_ADMIN_USER=a-admin
FM_BOOTSTRAP_ADMIN_PASSWORD=passwordDemand

# Show the list of login-capable host users on the login page.
FM_EXPOSE_USER_LIST=true

# Real per-user permission enforcement (set to false only if the host cannot switch credentials).
FM_IMPERSONATION_ENABLED=true

# Development gives detailed errors and developer exception pages; Production is the default.
# Set to Development while debugging in Docker from Visual Studio.
ASPNETCORE_ENVIRONMENT=Production

# Host port for PostgreSQL (loopback only). Used by the Visual Studio "Docker" (single project)
# launch profile together with host.docker.internal.
FM_DB_HOST_PORT=55432
