# Copy to .env and adjust. .env itself is git-ignored.
POSTGRES_DB=filemanager
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=filemanager

# Emergency administrator created inside the container (requirement 5).
# The value below is the documented default - change it for anything reachable.
FM_BOOTSTRAP_ADMIN_USER=a-admin
FM_BOOTSTRAP_ADMIN_PASSWORD=passwordDemand

# Show the list of login-capable host users on the login page.
FM_EXPOSE_USER_LIST=true
